terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    # Configure backend with -backend-config options or backend.hcl file
    # bucket = "your-terraform-state-bucket"
    # key    = "arcgis-enterprise/terraform.tfstate"
    # region = "us-east-1"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
      Purpose     = "ArcGIS-Enterprise-Daily-Build"
    }
  }
}
