# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values

aws_region      = "us-east-1"
environment     = "daily-build"
project_name    = "arcgis-enterprise"
s3_bucket_name  = "your-arcgis-builds-bucket"
arcgis_version  = "11.2"
key_pair_name   = "your-ec2-key-pair"

# Instance types (adjust based on workload)
linux_instance_type   = "t3.xlarge"
windows_instance_type = "t3.xlarge"
eks_node_instance_type = "t3.large"
eks_node_count        = 3

# Enable/disable components
enable_linux   = true
enable_windows = true
enable_eks     = true

# Network configuration
allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict this in production!
